# ─────────────────────────────────────────────
# Server environment – copy to .env and fill in
# ─────────────────────────────────────────────

# Bind port – Render injects this automatically; leave as-is
PORT=5000

# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net

# JWT signing secret – use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET

# Cloudinary media storage (for profile pictures and file uploads)
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

# ─────────────────────────────────────────────
# CORS – comma-separated list of allowed origins
# Add your Vercel URL here. No trailing slash.
# Example: https://your-app.vercel.app,https://custom-domain.com
# ─────────────────────────────────────────────
CORS_ORIGINS=https://YOUR_APP.vercel.app
